# Copy to .env on the server and adjust as needed (.env is gitignored).

# Where the CAIDF data tree is mounted on the server.
CAIDF_DATA_ROOT=/media/data/caidf_data

# Ollama daemon (local). Usually already running on the hackathon server.
OLLAMA_HOST=http://localhost:11434

# Default models (override to trade speed vs quality).
ROBOCOP_CHAT_MODEL=gemma3:27b
ROBOCOP_CODE_MODEL=qwen2.5-coder:32b
ROBOCOP_EMBED_MODEL=mxbai-embed-large
ROBOCOP_ST_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
